<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gerador de Currículo</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><text y='24' font-size='24'>📄</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css?v=1">

  <!-- pdfmake via CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.10/pdfmake.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.10/vfs_fonts.min.js"></script>
</head>
<body class="form-page">

<nav id="nav">
  <div class="nav-logo"><a href="/">Currículo</a></div>
</nav>

<div class="container">
  <h1>📄 Gerador de Currículo</h1>

  <form id="form" novalidate>

    <label>Nome completo *</label>
    <input type="text" id="nome" placeholder="João da Silva">
    <div class="err-msg" id="err-nome"></div>

    <label>Cargo / título *</label>
    <input type="text" id="cargo" placeholder="Desenvolvedor Full Stack">
    <div class="err-msg" id="err-cargo"></div>

    <div class="row">
      <div>
        <label>E-mail *</label>
        <input type="email" id="email" placeholder="joao@email.com">
        <div class="err-msg" id="err-email"></div>
      </div>
      <div>
        <label>Telefone</label>
        <input type="text" id="tel" placeholder="(11) 99999-9999">
      </div>
    </div>

    <div class="row">
      <div>
        <label>Cidade / Estado</label>
        <input type="text" id="cidade" placeholder="São Paulo, SP">
      </div>
      <div>
        <label>LinkedIn</label>
        <input type="text" id="linkedin" placeholder="linkedin.com/in/joao">
      </div>
    </div>

    <label>Experiências profissionais *</label>
    <div id="experiencias-container" class="dynamic-container">
      <div class="dynamic-item">
        <div class="row">
          <div>
            <label class="sub-label">Cargo *</label>
            <input type="text" class="exp-cargo" placeholder="Desenvolvedor Full Stack">
          </div>
          <div>
            <label class="sub-label">Empresa *</label>
            <input type="text" class="exp-empresa" placeholder="Empresa X">
          </div>
        </div>
        <div class="row">
          <div>
            <label class="sub-label">Data de Início *</label>
            <input type="date" class="exp-inicio">
          </div>
          <div>
            <label class="sub-label">Data de Fim</label>
            <input type="date" class="exp-fim">
          </div>
        </div>
        <div>
          <label class="sub-label">Descrição</label>
          <textarea class="exp-descricao" rows="2" placeholder="Criei APIs REST, liderei equipe de 4 pessoas..."></textarea>
        </div>
      </div>
    </div>
    <button type="button" class="btn-add" id="btn-add-exp">+ Adicionar experiência</button>
    <div class="err-msg" id="err-exp"></div>

    <label>Formação acadêmica *</label>
    <div id="formacao-container" class="dynamic-container">
      <div class="dynamic-item">
        <div class="row">
          <div>
            <label class="sub-label">Curso *</label>
            <input type="text" class="form-curso" placeholder="Bacharelado em Ciência da Computação">
          </div>
          <div>
            <label class="sub-label">Instituição *</label>
            <input type="text" class="form-instituicao" placeholder="USP">
          </div>
        </div>
        <div class="row">
          <div>
            <label class="sub-label">Data de Início *</label>
            <input type="date" class="form-inicio">
          </div>
          <div>
            <label class="sub-label">Data de Fim *</label>
            <input type="date" class="form-fim">
          </div>
        </div>
      </div>
    </div>
    <button type="button" class="btn-add" id="btn-add-form">+ Adicionar formação</button>
    <div class="err-msg" id="err-form"></div>

    <label>Habilidades</label>
    <input type="text" id="skills" placeholder="JavaScript, React, Node.js, SQL, Inglês fluente...">

    <label>Idioma do currículo</label>
    <select id="idioma">
      <option value="pt">Português</option>
      <option value="en">Inglês</option>
      <option value="es">Espanhol</option>
    </select>

    <button type="submit">Gerar currículo</button>
  </form>

  <!-- Resultado -->
  <div id="resultado">
    <h2>✅ Currículo gerado</h2>
    <div id="cv-texto"></div>
    <div class="botoes-dl">
      <button id="btn-baixar">⬇ Baixar PDF</button>
    </div>
  </div>
</div>

<script>
// ── Dados do currículo (estado global) ──────────────────────
let dadosCurriculo = null;

// ── Validação ───────────────────────────────────────────────
function validar() {
  const camposBasicos = [
    { id: 'nome',         err: 'err-nome',  msg: 'Informe seu nome' },
    { id: 'cargo',        err: 'err-cargo', msg: 'Informe seu cargo' },
    { id: 'email',        err: 'err-email', msg: 'Informe um e-mail válido',
      fn: v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) },
  ];

  let ok = true;
  
  // Validar campos básicos
  for (const c of camposBasicos) {
    const el    = document.getElementById(c.id);
    const errEl = document.getElementById(c.err);
    const valido = c.fn ? c.fn(el.value.trim()) : el.value.trim().length > 0;
    errEl.textContent = valido ? '' : c.msg;
    el.classList.toggle('error', !valido);
    if (!valido) ok = false;
  }

  // Validar experiências
  const expItens = document.querySelectorAll('#experiencias-container .dynamic-item');
  const errExpEl = document.getElementById('err-exp');
  let expValida = true;
  expItens.forEach((item, idx) => {
    const cargo = item.querySelector('.exp-cargo').value.trim();
    const empresa = item.querySelector('.exp-empresa').value.trim();
    const inicio = item.querySelector('.exp-inicio').value.trim();
    
    if (!cargo || !empresa || !inicio) {
      expValida = false;
    }
  });
  
  if (expItens.length === 0) expValida = false;
  
  if (!expValida) {
    errExpEl.textContent = 'Preencha pelo menos uma experiência completa (cargo, empresa e data de início)';
    ok = false;
  } else {
    errExpEl.textContent = '';
  }

  // Validar formação
  const formItens = document.querySelectorAll('#formacao-container .dynamic-item');
  const errFormEl = document.getElementById('err-form');
  let formValida = true;
  formItens.forEach((item, idx) => {
    const curso = item.querySelector('.form-curso').value.trim();
    const instituicao = item.querySelector('.form-instituicao').value.trim();
    const inicio = item.querySelector('.form-inicio').value.trim();
    const fim = item.querySelector('.form-fim').value.trim();
    
    if (!curso || !instituicao || !inicio || !fim) {
      formValida = false;
    }
  });
  
  if (formItens.length === 0) formValida = false;
  
  if (!formValida) {
    errFormEl.textContent = 'Preencha pelo menos uma formação completa (curso, instituição e datas)';
    ok = false;
  } else {
    errFormEl.textContent = '';
  }

  return ok;
}

function formatDate(value, idioma) {
  if (!value) return '';
  const parts = value.split('-');
  if (parts.length !== 3) return value;
  if (idioma === 'en') {
    // US format: MM/DD/YYYY
    return `${parts[1]}/${parts[2]}/${parts[0]}`;
  } else {
    // Default to DD/MM/YYYY for pt and es
    return `${parts[2]}/${parts[1]}/${parts[0]}`;
  }
}

// ── Pré-visualização em texto ────────────────────────────────
function montarPreview(d) {
  const sep = '──────────────────────────────────────';
  const secoes = {
    pt: { contato: 'CONTATO', exp: 'EXPERIÊNCIA PROFISSIONAL', form: 'FORMAÇÃO ACADÊMICA', hab: 'HABILIDADES', andamento: '(em andamento)', at: 'na', email: 'E-mail: ', telefone: 'Telefone: ', localizacao: 'Localização: ', linkedin: 'LinkedIn: ' },
    en: { contato: 'CONTACT',  exp: 'WORK EXPERIENCE',          form: 'EDUCATION',           hab: 'SKILLS',      andamento: '(ongoing)',      at: 'at', email: 'Email: ',    telefone: 'Phone: ',     localizacao: 'Location: ',   linkedin: 'LinkedIn: ' },
    es: { contato: 'CONTACTO', exp: 'EXPERIENCIA PROFESIONAL',  form: 'FORMACIÓN ACADÉMICA', hab: 'HABILIDADES', andamento: '(en curso)',     at: 'en', email: 'Correo: ',  telefone: 'Teléfono: ',  localizacao: 'Ubicación: ',  linkedin: 'LinkedIn: ' },
  }[d.idioma];

  let cv = '';
  cv += d.nome.toUpperCase() + '\n';
  cv += d.cargo + '\n';
  cv += sep + '\n\n';
  cv += secoes.contato + '\n';
  cv += secoes.email + d.email + '\n';
  if (d.tel)      cv += secoes.telefone    + d.tel      + '\n';
  if (d.cidade)   cv += secoes.localizacao + d.cidade   + '\n';
  if (d.linkedin) cv += secoes.linkedin    + d.linkedin + '\n';
  cv += '\n' + sep + '\n\n';
  cv += secoes.exp + '\n';
  d.experiencias.forEach(exp => {
    const dataFim = exp.fim ? ' – ' + formatDate(exp.fim, d.idioma) : ' ' + secoes.andamento;
    cv += exp.cargo + ' ' + secoes.at + ' ' + exp.empresa + ' (' + formatDate(exp.inicio, d.idioma) + dataFim + ')\n';
    if (exp.descricao) cv += exp.descricao + '\n';
  });
  cv += '\n' + sep + '\n\n';
  cv += secoes.form + '\n';
  d.formacao.forEach(form => {
    cv += form.curso + ' — ' + form.instituicao + ' (' + formatDate(form.inicio, d.idioma) + ' – ' + formatDate(form.fim, d.idioma) + ')\n';
  });
  if (d.skills) {
    cv += '\n' + sep + '\n\n';
    cv += secoes.hab + '\n';
    cv += d.skills + '\n';
  }
  return cv;
}

// ── Geração do PDF com pdfmake ───────────────────────────────
function gerarPDF(d) {
  const secoes = {
    pt: { contato: 'CONTATO', exp: 'EXPERIÊNCIA PROFISSIONAL', form: 'FORMAÇÃO ACADÊMICA', hab: 'HABILIDADES', andamento: '(em andamento)', at: 'na', email: 'E-mail: ', telefone: 'Telefone: ', localizacao: 'Localização: ', linkedin: 'LinkedIn: ' },
    en: { contato: 'CONTACT',  exp: 'WORK EXPERIENCE',          form: 'EDUCATION',           hab: 'SKILLS',      andamento: '(ongoing)',      at: 'at', email: 'Email: ',    telefone: 'Phone: ',     localizacao: 'Location: ',   linkedin: 'LinkedIn: ' },
    es: { contato: 'CONTACTO', exp: 'EXPERIENCIA PROFESIONAL',  form: 'FORMACIÓN ACADÉMICA', hab: 'HABILIDADES', andamento: '(en curso)',     at: 'en', email: 'Correo: ',  telefone: 'Teléfono: ',  localizacao: 'Ubicación: ',  linkedin: 'LinkedIn: ' },
  }[d.idioma];

  // Monta bloco de contato
  const contatoLinhas = [secoes.email + d.email];
  if (d.tel)      contatoLinhas.push(secoes.telefone + d.tel);
  if (d.cidade)   contatoLinhas.push(secoes.localizacao + d.cidade);
  if (d.linkedin) contatoLinhas.push(secoes.linkedin + d.linkedin);

  // Monta seção de experiências
  const expLinhas = d.experiencias.map(exp => {
    const dataFim = exp.fim ? ' – ' + formatDate(exp.fim, d.idioma) : ' ' + secoes.andamento;
    let texto = exp.cargo + ' ' + secoes.at + ' ' + exp.empresa + ' (' + formatDate(exp.inicio, d.idioma) + dataFim + ')';
    if (exp.descricao) texto += '\n' + exp.descricao;
    return texto;
  });

  // Monta seção de formação
  const formLinhas = d.formacao.map(form => {
    return form.curso + ' — ' + form.instituicao + ' (' + formatDate(form.inicio, d.idioma) + ' – ' + formatDate(form.fim, d.idioma) + ')';
  });

  // Seção de habilidades (opcional)
  const secaoHabilidades = d.skills ? [
    { text: secoes.hab, style: 'sectionHeader', margin: [0, 18, 0, 6] },
    { canvas: [{ type: 'line', x1: 0, y1: 0, x2: 515, y2: 0, lineWidth: 0.5, lineColor: '#cccccc' }] },
    { text: d.skills, style: 'body', margin: [0, 8, 0, 0] }
  ] : [];

  const docDefinition = {
    pageSize: 'A4',
    pageMargins: [40, 50, 40, 50],

    styles: {
      nome: {
        fontSize: 24,
        bold: true,
        color: '#161310',
        characterSpacing: 1,
      },
      cargo: {
        fontSize: 12,
        color: '#c9973a',
        margin: [0, 4, 0, 0],
      },
      sectionHeader: {
        fontSize: 8,
        bold: true,
        color: '#8c7e74',
        characterSpacing: 2,
        margin: [0, 16, 0, 4],
      },
      body: {
        fontSize: 10,
        color: '#2a2420',
        lineHeight: 1.6,
      },
      contactLine: {
        fontSize: 10,
        color: '#555',
        lineHeight: 1.5,
      },
    },

    defaultStyle: {
      font: 'Roboto',
    },

    content: [
      // Cabeçalho
      { text: d.nome.toUpperCase(), style: 'nome' },
      { text: d.cargo, style: 'cargo' },
      { canvas: [{ type: 'line', x1: 0, y1: 0, x2: 515, y2: 0, lineWidth: 1, lineColor: '#c9973a' }], margin: [0, 12, 0, 0] },

      // Contato
      { text: secoes.contato, style: 'sectionHeader', margin: [0, 16, 0, 6] },
      { canvas: [{ type: 'line', x1: 0, y1: 0, x2: 515, y2: 0, lineWidth: 0.5, lineColor: '#cccccc' }] },
      {
        ul: contatoLinhas,
        style: 'contactLine',
        margin: [0, 8, 0, 0],
        markerColor: '#c9973a',
      },

      // Experiência
      { text: secoes.exp, style: 'sectionHeader', margin: [0, 18, 0, 6] },
      { canvas: [{ type: 'line', x1: 0, y1: 0, x2: 515, y2: 0, lineWidth: 0.5, lineColor: '#cccccc' }] },
      {
        ul: expLinhas,
        style: 'body',
        margin: [0, 8, 0, 0],
        markerColor: '#c9973a',
      },

      // Formação
      { text: secoes.form, style: 'sectionHeader', margin: [0, 18, 0, 6] },
      { canvas: [{ type: 'line', x1: 0, y1: 0, x2: 515, y2: 0, lineWidth: 0.5, lineColor: '#cccccc' }] },
      {
        ul: formLinhas,
        style: 'body',
        margin: [0, 8, 0, 0],
        markerColor: '#c9973a',
      },

      // Habilidades (condicional)
      ...secaoHabilidades,
    ],
  };

  const nomeArquivo = d.nome.toLowerCase().replace(/\s+/g, '_') + '_curriculo.pdf';
  pdfMake.createPdf(docDefinition).download(nomeArquivo);
}

// ── Adicionar campos dinâmicos ──────────────────────────────
function adicionarExperiencia() {
  const container = document.getElementById('experiencias-container');
  const novoItem = document.createElement('div');
  novoItem.className = 'dynamic-item';
  novoItem.innerHTML = `
    <div class="row">
      <div>
        <label class="sub-label">Cargo *</label>
        <input type="text" class="exp-cargo" placeholder="Desenvolvedor Full Stack">
      </div>
      <div>
        <label class="sub-label">Empresa *</label>
        <input type="text" class="exp-empresa" placeholder="Empresa X">
      </div>
    </div>
    <div class="row">
      <div>
        <label class="sub-label">Data de Início *</label>
        <input type="date" class="exp-inicio">
      </div>
      <div>
        <label class="sub-label">Data de Fim</label>
        <input type="date" class="exp-fim">
      </div>
    </div>
    <div>
      <label class="sub-label">Descrição</label>
      <textarea class="exp-descricao" rows="2" placeholder="Criei APIs REST, liderei equipe de 4 pessoas..."></textarea>
    </div>
    <button type="button" class="btn-remove" onclick="this.parentElement.remove()">✕ Remover</button>
  `;
  container.appendChild(novoItem);
}

function adicionarFormacao() {
  const container = document.getElementById('formacao-container');
  const novoItem = document.createElement('div');
  novoItem.className = 'dynamic-item';
  novoItem.innerHTML = `
    <div class="row">
      <div>
        <label class="sub-label">Curso *</label>
        <input type="text" class="form-curso" placeholder="Bacharelado em Ciência da Computação">
      </div>
      <div>
        <label class="sub-label">Instituição *</label>
        <input type="text" class="form-instituicao" placeholder="USP">
      </div>
    </div>
    <div class="row">
      <div>
        <label class="sub-label">Data de Início *</label>
        <input type="date" class="form-inicio">
      </div>
      <div>
        <label class="sub-label">Data de Fim *</label>
        <input type="date" class="form-fim">
      </div>
    </div>
    <button type="button" class="btn-remove" onclick="this.parentElement.remove()">✕ Remover</button>
  `;
  container.appendChild(novoItem);
}

// ── Event listeners para adicionar campos ────────────────────
document.getElementById('btn-add-exp').addEventListener('click', (e) => {
  e.preventDefault();
  adicionarExperiencia();
});

document.getElementById('btn-add-form').addEventListener('click', (e) => {
  e.preventDefault();
  adicionarFormacao();
});

// ── Submit ───────────────────────────────────────────────────
document.getElementById('form').addEventListener('submit', (e) => {
  e.preventDefault();
  if (!validar()) return;

  // Coletar experiências
  const experiencias = [];
  document.querySelectorAll('#experiencias-container .dynamic-item').forEach(item => {
    experiencias.push({
      cargo: item.querySelector('.exp-cargo').value.trim(),
      empresa: item.querySelector('.exp-empresa').value.trim(),
      inicio: item.querySelector('.exp-inicio').value.trim(),
      fim: item.querySelector('.exp-fim').value.trim(),
      descricao: item.querySelector('.exp-descricao').value.trim(),
    });
  });

  // Coletar formação
  const formacao = [];
  document.querySelectorAll('#formacao-container .dynamic-item').forEach(item => {
    formacao.push({
      curso: item.querySelector('.form-curso').value.trim(),
      instituicao: item.querySelector('.form-instituicao').value.trim(),
      inicio: item.querySelector('.form-inicio').value.trim(),
      fim: item.querySelector('.form-fim').value.trim(),
    });
  });

  dadosCurriculo = {
    nome:         document.getElementById('nome').value.trim(),
    cargo:        document.getElementById('cargo').value.trim(),
    email:        document.getElementById('email').value.trim(),
    tel:          document.getElementById('tel').value.trim(),
    cidade:       document.getElementById('cidade').value.trim(),
    linkedin:     document.getElementById('linkedin').value.trim(),
    experiencias: experiencias,
    formacao:     formacao,
    skills:       document.getElementById('skills').value.trim(),
    idioma:       document.getElementById('idioma').value,
  };

  // Mostra pré-visualização em texto
  document.getElementById('cv-texto').textContent = montarPreview(dadosCurriculo);

  const resultado = document.getElementById('resultado');
  resultado.style.display = 'block';
  resultado.scrollIntoView({ behavior: 'smooth' });
});

// ── Botão de download PDF ────────────────────────────────────
document.getElementById('btn-baixar').addEventListener('click', () => {
  if (!dadosCurriculo) return;
  gerarPDF(dadosCurriculo);
});
</script>

</body>
</html>
